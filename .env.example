# ── Telegram ───────────────────────────────────────────────
# 1) 텔레그램에서 @BotFather 에게 /newbot → 토큰 받기
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# 2) 만든 봇에게 아무 메시지나 보낸 뒤 아래로 chat_id 확인:
#    curl -s "https://api.telegram.org/bot<토큰>/getUpdates" | grep -o '"id":[0-9-]*' | head -1
TELEGRAM_CHAT_ID=1234567890

# ── 경로 (기본값이 맞으면 생략 가능) ──────────────────────
PROJECTS_DIR=/Users/jslee/Projects
# LOCAL_YT_SCRIPT_DIR=/Users/jslee/Projects/yt-script
# LOCAL_YT_PRODUCTION_DIR=/Users/jslee/Projects/yt-production_whisk
# LOCAL_YT_UPLOAD_DIR=/Users/jslee/Projects/yt-upload

# ── 실행 환경 ──────────────────────────────────────────────
# yt-production/yt-upload 의존성이 깔린 인터프리터
PYTHON_BIN=/usr/local/bin/python3
# 마지막 성공 이후 이 일수를 넘기면 /status가 경고
STALE_WARN_DAYS=3
